# Enforce LF line endings across all text files (P0-T01)
* text=auto eol=lf

# Explicit text files
*.rs text eol=lf
*.toml text eol=lf
*.proto text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
justfile text eol=lf

# Binary assets & golden wire fixtures
*.bin binary
*.png binary
*.ico binary
*.icns binary
*.woff2 binary
*.zip binary
*.gz binary
*.exe binary
*.msi binary
