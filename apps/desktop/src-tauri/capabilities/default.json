{
  "$schema": "https://schema.tauri.app/config/2/capability",
  "identifier": "default",
  "description": "Least-privilege capability set for Vortex Desktop main & dialog windows (P1-T30 / §17.2)",
  "windows": ["main", "confirm"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "core:window:allow-close",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "notification:default"
  ]
}
